{
  "name": "cyclecloud-multi-region-docs",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/patch-serve-handler.mjs && node scripts/patch-deepmerge.mjs",
    "test": "node --test tests/*.test.mjs",
    "diagrams": "node scripts/build-diagram.mjs",
    "prestart": "npm run diagrams",
    "start": "docusaurus start --host 127.0.0.1 --port 3000 --no-open",
    "prebuild": "npm run diagrams",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1 --port 3000 --no-open"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "deepmerge": "4.3.1",
    "tinypool": "~2.2.0",
    "serialize-javascript": "~7.1.4",
    "minimatch": "~11.0.4",
    "uuid": "~14.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "browserslist": {
    "production": [">0.5%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}

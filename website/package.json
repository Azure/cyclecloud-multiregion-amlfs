{
  "name": "cyclecloud-multiregion-amlfs-docs",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/patch-serve-handler.mjs && node scripts/patch-deepmerge.mjs",
    "test": "node --test tests/*.test.mjs",
    "diagrams": "node scripts/build-diagram.mjs",
    "prestart": "npm run diagrams",
    "start": "docusaurus start --host 127.0.0.1 --port 3000 --no-open",
    "prebuild": "npm run diagrams",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1 --port 3000 --no-open"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "notice-browser-pack": "npm:browser-pack@6.1.0",
    "notice-chevrotain-allstar": "npm:chevrotain-allstar@0.5.0",
    "notice-fastdom": "npm:fastdom@1.0.12",
    "notice-fmin": "npm:fmin@0.0.4",
    "notice-langium": "npm:langium@4.4.0",
    "notice-prismjs": "npm:prismjs@1.29.0",
    "notice-vscode-jsonrpc": "npm:vscode-jsonrpc@9.0.3",
    "notice-vscode-languageserver-protocol": "npm:vscode-languageserver-protocol@3.18.4",
    "notice-vscode-languageserver-textdocument": "npm:vscode-languageserver-textdocument@1.0.15",
    "notice-vscode-languageserver-types": "npm:vscode-languageserver-types@3.18.4",
    "notice-web-worker": "npm:web-worker@1.4.1"
  },
  "overrides": {
    "deepmerge": "4.3.1",
    "tinypool": "~2.2.0",
    "serialize-javascript": "~7.1.4",
    "minimatch": "~11.0.4",
    "uuid": "~14.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "browserslist": {
    "production": [">0.5%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}
